{
  "name": "woosung-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-media": "node scripts/sync-media.mjs",
    "atlas": "py -3 scripts/build-atlas.py",
    "dev": "node scripts/sync-media.mjs && next dev -p 18783",
    "prebuild": "node scripts/sync-media.mjs",
    "build": "next build",
    "postbuild": "node scripts/relativize.mjs && node scripts/verify-out.mjs",
    "serve": "py -3 -m http.server 18784 --bind 127.0.0.1 --directory out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "lenis": "^1.3.27",
    "next": "^16.4.5",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swiper": "^14.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
}
